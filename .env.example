# Server-side only — set in .env for local Vite, and in Vercel for production.
# MUST be GROQ_API_KEY (not VITE_GROQ_API_KEY). VITE_ would either expose the
# key in the browser bundle or never reach the /api/groq proxy.
GROQ_API_KEY=

# SerpAPI key for real web search (server-side only)
SERPAPI_KEY=

# YouTube Data API v3 key (server-side only)
YOUTUBE_API_KEY=

# Public site URL used in password reset emails
VITE_SITE_URL=https://mytuta.org

# Optional: override hardcoded Supabase client (recommended for production)
# VITE_SUPABASE_URL=https://jjynszwhwmbkwuoezorb.supabase.co
# VITE_SUPABASE_ANON_KEY=

# ---- Error monitoring (Phase 7) ----
# Optional: set a Sentry DSN to route errors to Sentry instead of Supabase.
# Install @sentry/react and call Sentry.init({ dsn }) in src/main.tsx.
# VITE_SENTRY_DSN=https://...@sentry.io/...
# Human-readable release tag shown in error logs (auto-set to VERCEL_GIT_COMMIT_SHA in Vercel).
# VITE_APP_RELEASE=local

# ---- Tuta Credits / Paystack (monetization) ----
# Deployed as Netlify functions (netlify/functions/paystack-*), reached at
# /api/paystack-verify, /api/paystack-webhook and /api/paystack-refund via the
# redirects in netlify.toml. Set the server vars below in the Netlify site env.
#
# Client-side public key (safe to expose; used by the Paystack popup).
VITE_PAYSTACK_PUBLIC_KEY=
# Subscription plan codes (PLN_...) from the Paystack dashboard. The client needs
# the VITE_ copies to start a subscription; the webhook needs the un-prefixed
# copies to map a plan_code back to a plan on renewals. Set BOTH for each plan.
VITE_PAYSTACK_PLAN_STUDENT_PLUS=
VITE_PAYSTACK_PLAN_TEACHER_PRO=
PAYSTACK_PLAN_STUDENT_PLUS=
PAYSTACK_PLAN_TEACHER_PRO=
# Server-side only. Used by paystack-verify/webhook/refund. NEVER prefix VITE_.
PAYSTACK_SECRET_KEY=
# Server-side Supabase service role key — lets the verify + webhook functions
# grant credits after a payment. NEVER prefix with VITE_ (would leak it).
SUPABASE_SERVICE_ROLE_KEY=
