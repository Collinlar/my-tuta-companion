# ── mytuta Staging Environment ────────────────────────────────────────────────
# Copy these into Vercel's "Preview" environment, not Production.
# Use a SEPARATE Supabase project for staging — never share the production DB.

# AI
GROQ_API_KEY=gsk_staging_...

# Supabase — staging project (create at supabase.com, separate from prod)
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<staging-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>

# Payments — use Paystack TEST keys in staging (never live keys)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

# App
VITE_SITE_URL=https://staging.mytuta.org
VITE_APP_RELEASE=staging

# Optional: Sentry DSN for staging error tracking
# VITE_SENTRY_DSN=https://...@sentry.io/...

# Vercel auto-populates this in CI builds (do not set manually):
# VERCEL_GIT_COMMIT_SHA
